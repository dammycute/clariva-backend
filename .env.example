SECRET_KEY=change-me-to-a-random-string
DEBUG=True
DATABASE_URL=postgres://user:password@localhost:5432/clariva
CORS_ALLOWED_ORIGINS=http://localhost:3000
FERNET_KEYS=
# Production: DEBUG=False, ALLOWED_HOSTS, NUM_PROXIES (reverse proxies in front), DB_SSLMODE

# --- Hosting on Vercel + Supabase (production) ---
# DEBUG=False
# SECRET_KEY=<long random string>
# ALLOWED_HOSTS=<your-api-domain>        (the *.vercel.app host is added automatically)
# CORS_ALLOWED_ORIGINS=https://<your-web-domain>
# DATABASE_URL=postgres://postgres.<ref>:<url-encoded-password>@<pooler-host>:6543/postgres
# DB_POOLED=true                          (when using the transaction pooler on port 6543)
# CACHE_BACKEND=db                        (share OTP codes and rate limits across serverless calls)
# NUM_PROXIES=1
# FERNET_KEYS=<comma-separated keys>
# ENABLE_ADMIN=false
