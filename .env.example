# Clariva backend settings. Copy this file to `.env` and fill it in.
# Never commit `.env`. Never put real secrets in this example file.

# ---------------------------------------------------------------------------
# Local development (these values are safe defaults)
# ---------------------------------------------------------------------------

# True only on your own computer. Production must be False.
DEBUG=True

# Required when DEBUG=False. In development a built-in dev key is used if empty.
SECRET_KEY=change-me-to-a-random-string

# postgres://user:password@host:port/name  (URL-encode special characters in the password)
# Leave out to use a local SQLite file.
DATABASE_URL=postgres://user:password@localhost:5432/clariva

# Comma-separated hosts this API answers to.
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated web addresses allowed to call this API (the web app).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Keys that encrypt student data (comma-separated). Keep them forever: if they
# are lost, the encrypted data cannot be read. Make one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEYS=

# `locmem` keeps OTP codes and rate limits in memory (fine for one local process).
# `db` keeps them in the database (needed on Vercel and with several workers).
CACHE_BACKEND=locmem

# true when connecting through a transaction pooler (for example Supabase port 6543).
DB_POOLED=false

# Database SSL mode. Default: `prefer` in development, `require` in production.
DB_SSLMODE=prefer

# How many reverse proxies sit in front of the API, so rate limits see the real
# visitor address. 0 locally, 1 on Vercel.
NUM_PROXIES=0

# Django admin site. On by default in development, off in production (Vercel
# cannot serve its style files).
ENABLE_ADMIN=true

# Redirect http to https. Only used when DEBUG=False. Default True.
SECURE_SSL_REDIRECT=True

# VERCEL_URL is set by Vercel itself. Do not set it.

# ---------------------------------------------------------------------------
# Production on Vercel + Supabase: set these in the Vercel project settings
# ---------------------------------------------------------------------------
# DEBUG=False
# SECRET_KEY=<long random string: python -c "import secrets; print(secrets.token_urlsafe(50))">
# DATABASE_URL=postgres://postgres.<project-ref>:<url-encoded-password>@<pooler-host>:6543/postgres
# DB_POOLED=true
# CACHE_BACKEND=db
# FERNET_KEYS=<your keys>
# ALLOWED_HOSTS=<your-api-domain>
# CORS_ALLOWED_ORIGINS=https://<your-web-domain>
# NUM_PROXIES=1
# ENABLE_ADMIN=false

# ---------------------------------------------------------------------------
# Billing (apps.billing)
# ---------------------------------------------------------------------------
# Leave false until every existing school has been covered, then switch it on.
BILLING_ENFORCE=False
# Paystack keys: Dashboard -> Developers -> API configuration (older dashboards:
# Settings -> API Keys & Webhooks). Test and live keys are separate.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Optional. Generated on the same page, in the "Webhook signing secret" section:
# it starts with whsec_, is not your secret key, and is separate for test and live.
# Leave it empty to keep verifying the older x-paystack-signature header with the
# secret key instead.
PAYSTACK_SIGNING_SECRET=
# Where Paystack sends the browser back to (the portal's billing page).
PAYSTACK_CALLBACK_URL=http://localhost:3000/dashboard/billing
# Shared secret the scheduled reminder job must present.
BILLING_CRON_SECRET=
# Receipt and reminder email sender. Defaults to DEMO_FROM_EMAIL.
BILLING_FROM_EMAIL=
